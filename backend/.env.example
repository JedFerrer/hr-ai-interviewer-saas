# --- Environment ---
ENVIRONMENT=development
PORTFOLIO_DEMO=false

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./hr_interviewer.db

# --- Auth (JWT) ---
# Generate privately with: python backend/scripts/setup_local.py
# Required to be >=32 chars and not a known default. App refuses to start
# in production with a weak/default key.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Account lockout ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Test email bypass (DO NOT enable in production) ---
ENABLE_TEST_EMAILS=false
TEST_EMAILS=                       # comma-separated list, only used when ENABLE_TEST_EMAILS=true

# --- LLM ---
LLM_PROVIDER=openai                # openai | deepseek | anthropic
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=             # only for non-workspace-scoped Anthropic keys
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REQUEST_LIMIT=0                # optional per-process cap; 0 = unlimited
LLM_MAX_INPUT_BYTES=0              # optional per-request cap; 0 = unlimited
LLM_FALLBACK_PROVIDERS=            # comma-separated, e.g. "anthropic,openai"

# --- Storage (Supabase) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=resumes

# --- Email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=                        # verified Resend sender; blank disables delivery

# --- App ---
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Rate limiting ---
# Empty = in-memory storage (single uvicorn worker only). For production with
# shared rate limits only; multiple workers remain unsupported:
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=
RATE_LIMIT_ENABLED=true

# Supported Next custom server, bound to loopback. Generate a separate random
# secret and put the SAME value in frontend/.env.local; never NEXT_PUBLIC.
TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
PROXY_AUTH_SECRET=
